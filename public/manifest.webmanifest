{
  "name": "Wayfare — Travel Journal",
  "short_name": "Wayfare",
  "description": "Map every place you go. Photos, food log, costs and ratings — printable and shareable.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F4F1EA",
